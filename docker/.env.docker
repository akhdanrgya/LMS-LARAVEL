#================================================================
# Docker Compose Environment Variables — GCP Production
#================================================================
# 1. Copy file ini ke .env di root project:
#      cp docker/.env.docker .env
# 2. Generate APP_KEY:
#      docker compose run --rm app php artisan key:generate --show
#    Lalu paste hasilnya di bawah.
# 3. Jalankan:
#      docker compose up -d --build
# 4. (Opsional) Seed database pertama kali:
#      Set DB_SEED=true, lalu restart container.
#================================================================

# ── App ─────────────────────────────────────────────────────────
APP_NAME="LMS TUBES"
APP_ENV=production
APP_KEY=                              # <<< WAJIB ISI! Jalankan perintah di atas.
APP_DEBUG=false
APP_URL=http://localhost:8080         # <<< Ganti ke IP/domain GCP lo
APP_PORT=8080
LOG_LEVEL=error

# ── Database ────────────────────────────────────────────────────
DB_DATABASE=lms_tubes
DB_USERNAME=lms_user
DB_PASSWORD=ganti-ke-password-kuat    # <<< WAJIB GANTI!
DB_ROOT_PASSWORD=ganti-root-password  # <<< WAJIB GANTI!
DB_PORT=3306

# ── Seeding (set true untuk deploy pertama, lalu false) ────────
DB_SEED=false

# ── phpMyAdmin (opsional) ──────────────────────────────────────
# Jalankan: docker compose --profile debug up -d
PMA_PORT=8888
